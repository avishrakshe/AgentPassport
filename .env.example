# Envio HyperIndex GraphQL Endpoint
ENVIO_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql

# Dynamic SDK
DYNAMIC_ENVIRONMENT_ID=your-dynamic-environment-id

# Trust & Analytics Integrations
CLEANVERSE_API_KEY=your-cleanverse-api-key
NANSEN_API_KEY=your-nansen-api-key
