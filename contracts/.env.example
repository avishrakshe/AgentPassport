# Monad Testnet RPC URL (format: https://monad-testnet.g.alchemy.com/v2/<key> or https://testnet-rpc.monad.xyz)
ALCHEMY_MONAD_RPC_URL=https://monad-testnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer Private Key (without 0x prefix or with 0x prefix)
PRIVATE_KEY=your_private_key_here

# Optional: Monadscan API key for contract verification
MONADSCAN_API_KEY=your_monadscan_api_key_here
